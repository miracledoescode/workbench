# Provider: "anthropic" (default) or "openai" (any OpenAI-compatible /chat/completions endpoint)
WORKBENCH_PROVIDER=anthropic
# Pick a model ID valid for your provider
WORKBENCH_MODEL=

# --- provider=anthropic ---
ANTHROPIC_API_KEY=

# --- provider=openai: set the provider's OpenAI-compatible base URL (check its docs) ---
# e.g. local Ollama: http://localhost:11434/v1  (no key needed)
WORKBENCH_BASE_URL=
WORKBENCH_API_KEY=

# Optional: USD per million tokens — enables cost tracking (leave blank or 0 for free tiers)
WORKBENCH_PRICE_IN=
WORKBENCH_PRICE_OUT=
